[
  {
    "name": "Anthropic: a string system, cloaked on Antigravity; the user's turn is not",
    "provider": { "id": "7c1958d885953cd3", "name": "Antigravity", "account": "antigravity", "model": "gemini-3-flash" },
    "request": { "model": "m", "system": "You are Cursor, an AI coding assistant.", "messages": [{ "role": "user", "content": "Cursor is great" }] },
    "expect_request": { "model": "m", "system": "You are C\u200bu\u200brsor, an AI coding assistant.", "messages": [{ "role": "user", "content": "Cursor is great" }] }
  },
  {
    "name": "Anthropic: text blocks",
    "provider": { "id": "7c1958d885953cd3", "name": "Antigravity", "account": "antigravity", "model": "gemini-3-flash" },
    "request": { "model": "m", "system": [{ "type": "text", "text": "You are Windsurf." }], "messages": [] },
    "expect_request": { "model": "m", "system": [{ "type": "text", "text": "You are W\u200bi\u200bndsurf." }], "messages": [] }
  },
  {
    "name": "A claude subscription gets the prompt as the agent wrote it",
    "provider": { "id": "c", "name": "Claude", "account": "claude", "model": "claude-sonnet-4-5" },
    "request": { "model": "m", "system": "You are Cursor.", "messages": [] }
  },
  {
    "name": "A key, with no account, gets it as it was",
    "provider": { "id": "k", "name": "Key", "model": "m" },
    "request": { "model": "m", "system": "You are Cursor.", "messages": [] }
  },
  {
    "name": "Chat: system and developer messages, not the user's",
    "provider": { "id": "7c1958d885953cd3", "name": "Antigravity", "account": "antigravity", "model": "gemini-3-flash" },
    "ctx": { "protocol": "chat" },
    "request": {
      "model": "m",
      "messages": [
        { "role": "system", "content": "You are Windsurf." },
        { "role": "developer", "content": [{ "type": "text", "text": "Devin here." }] },
        { "role": "user", "content": "Kiro?" }
      ]
    },
    "expect_request": {
      "model": "m",
      "messages": [
        { "role": "system", "content": "You are W\u200bi\u200bndsurf." },
        { "role": "developer", "content": [{ "type": "text", "text": "D\u200be\u200bvin here." }] },
        { "role": "user", "content": "Kiro?" }
      ]
    }
  },
  {
    "name": "Responses: instructions and a developer input item",
    "provider": { "id": "7c1958d885953cd3", "name": "Antigravity", "account": "antigravity", "model": "gemini-3-flash" },
    "ctx": { "protocol": "responses" },
    "request": {
      "model": "m",
      "instructions": "You are Codex CLI.",
      "input": [
        { "type": "message", "role": "developer", "content": [{ "type": "input_text", "text": "Inside Cline." }] },
        { "type": "message", "role": "user", "content": [{ "type": "input_text", "text": "Trae?" }] }
      ]
    },
    "expect_request": {
      "model": "m",
      "instructions": "You are C\u200bo\u200bdex C\u200bL\u200bI.",
      "input": [
        { "type": "message", "role": "developer", "content": [{ "type": "input_text", "text": "Inside C\u200bl\u200bine." }] },
        { "type": "message", "role": "user", "content": [{ "type": "input_text", "text": "Trae?" }] }
      ]
    }
  },
  {
    "name": "Gemini: systemInstruction",
    "provider": { "id": "7c1958d885953cd3", "name": "Antigravity", "account": "antigravity", "model": "gemini-3-flash" },
    "ctx": { "protocol": "gemini" },
    "request": { "systemInstruction": { "parts": [{ "text": "You are Trae." }] }, "contents": [] },
    "expect_request": { "systemInstruction": { "parts": [{ "text": "You are T\u200br\u200bae." }] }, "contents": [] }
  },
  {
