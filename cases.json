  {
    "name": "rewrite: the name becomes the mapping's value",
    "provider": { "id": "7c1958d885953cd3", "name": "Antigravity", "account": "antigravity", "model": "gemini-3-flash" },
    "options": { "mode": "rewrite" },
    "request": { "model": "m", "system": "You are Cursor.", "messages": [] },
    "expect_request": { "model": "m", "system": "You are Antigravity.", "messages": [] }
  },
  {
    "name": "rewrite: the longest name wins",
    "provider": { "id": "7c1958d885953cd3", "name": "Antigravity", "account": "antigravity", "model": "gemini-3-flash" },
    "options": { "mode": "rewrite" },
    "request": { "model": "m", "system": "You are GitHub Copilot CLI.", "messages": [] },
    "expect_request": { "model": "m", "system": "You are Antigravity.", "messages": [] }
  },
  {
    "name": "rewrite: Claude's Agent SDK line, grammar and all",
    "provider": { "id": "7c1958d885953cd3", "name": "Antigravity", "account": "antigravity", "model": "gemini-3-flash" },
    "options": { "mode": "rewrite" },
    "request": { "model": "m", "system": "You are a Claude agent, built on Anthropic's Claude Agent SDK.", "messages": [] },
    "expect_request": { "model": "m", "system": "You are a Antigravity, built on Anthropic's Antigravity SDK.", "messages": [] }
  },
  {
    "name": "a mode this middleware does not have falls back to cloak",
    "provider": { "id": "7c1958d885953cd3", "name": "Antigravity", "account": "antigravity", "model": "gemini-3-flash" },
    "options": { "mode": "block" },
    "request": { "model": "m", "system": "You are Cursor.", "messages": [] },
    "expect_request": { "model": "m", "system": "You are C\u200bu\u200brsor.", "messages": [] }
  },
  {
    "name": "customMappings overrides a default name",
    "provider": { "id": "7c1958d885953cd3", "name": "Antigravity", "account": "antigravity", "model": "gemini-3-flash" },
    "options": { "mode": "rewrite", "customMappings": { "Cursor": "MyIDE" } },
    "request": { "model": "m", "system": "You are Cursor.", "messages": [] },
    "expect_request": { "model": "m", "system": "You are MyIDE.", "messages": [] }
  },
  {
    "name": "customMappings as a comma-delimited string",
    "provider": { "id": "7c1958d885953cd3", "name": "Antigravity", "account": "antigravity", "model": "gemini-3-flash" },
    "options": { "mode": "rewrite", "customMappings": "Cursor: Zed, Windsurf: Zed" },
    "request": { "model": "m", "system": "You are Cursor with Windsurf.", "messages": [] },
    "expect_request": { "model": "m", "system": "You are Zed with Zed.", "messages": [] }
  },
  {
    "name": "useDefaultKeywords false leaves the preset out",
    "provider": { "id": "7c1958d885953cd3", "name": "Antigravity", "account": "antigravity", "model": "gemini-3-flash" },
    "options": { "mode": "rewrite", "useDefaultKeywords": false, "customMappings": { "Foo": "Bar" } },
    "request": { "model": "m", "system": "You are Cursor and Foo.", "messages": [] },
    "expect_request": { "model": "m", "system": "You are Cursor and Bar.", "messages": [] }
  },
  {
    "name": "case does not matter",
    "provider": { "id": "7c1958d885953cd3", "name": "Antigravity", "account": "antigravity", "model": "gemini-3-flash" },
    "options": { "mode": "rewrite" },
    "request": { "model": "m", "system": "you are cursor and WINDSURF.", "messages": [] },
    "expect_request": { "model": "m", "system": "you are Antigravity and Antigravity.", "messages": [] }
  },
  {
    "name": "accounts says which subscriptions",
    "provider": { "id": "g", "name": "Gemini", "account": "gemini", "model": "m" },
    "options": { "mode": "rewrite", "accounts": ["gemini"] },
    "request": { "model": "m", "system": "You are Cursor.", "messages": [] },
    "expect_request": { "model": "m", "system": "You are Antigravity.", "messages": [] }
  },
  {
    "name": "off leaves every request as it came",
    "provider": { "id": "7c1958d885953cd3", "name": "Antigravity", "account": "antigravity", "model": "gemini-3-flash" },
    "options": { "off": true },
    "request": { "model": "m", "system": "You are Cursor.", "messages": [] }
  },
  {
    "name": "no name anywhere: nothing changed",
    "provider": { "id": "7c1958d885953cd3", "name": "Antigravity", "account": "antigravity", "model": "gemini-3-flash" },
    "request": { "model": "m", "system": "You write TypeScript.", "messages": [{ "role": "user", "content": "hi" }] }
  }
]
