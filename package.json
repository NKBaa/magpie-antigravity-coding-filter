{
  "name": "magpie-antigravity-coding-filter",
  "version": "0.4.1",
  "description": "magpie gateway middleware: another coding agent's name in the system prompt is rewritten or cloaked, only on the request an Antigravity account is sent, with a page to set it up and see it work",
  "type": "module",
  "files": ["antigravity-coding-filter.middleware.js", "page", "README.md"],
  "keywords": ["magpie", "magpie-middleware", "magpie-page", "antigravity", "claude-code", "chatbox", "llm-gateway"],
  "license": "MIT",
  "magpie": {
    "middleware": "./antigravity-coding-filter.middleware.js",
    "page": {
      "title": "Antigravity coding filter",
      "titles": { "zh": "Antigravity 编码过滤" },
      "file": "page/index.html",
      "icon": "page/icon.svg"
    },
    "permissions": [],
    "options": {
      "mode": "cloak",
      "useDefaultKeywords": true,
      "useModelKeywords": false,
      "useAmbiguousKeywords": false,
      "customMappings": {},
      "accounts": ["antigravity"],
      "boundaries": true,
      "protectCode": true,
      "strictCase": false,
      "dryRun": false,
      "report": false,
      "off": false
    }
  }
}
