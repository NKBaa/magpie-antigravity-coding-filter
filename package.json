{
  "name": "magpie-antigravity-coding-filter",
  "version": "0.1.0",
  "description": "magpie gateway middleware: another coding agent's name in the system prompt is rewritten or cloaked, only on the request an Antigravity account is sent",
  "type": "module",
  "files": ["antigravity-coding-filter.middleware.js", "README.md"],
  "keywords": ["magpie", "magpie-middleware", "antigravity", "claude-code", "llm-gateway"],
  "license": "MIT",
  "magpie": {
    "middleware": "./antigravity-coding-filter.middleware.js",
    "options": {
      "mode": "cloak",
      "useDefaultKeywords": true,
      "customMappings": {},
      "accounts": ["antigravity"],
      "off": false
    }
  }
}
